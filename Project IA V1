local function extrairCodigoPuro(respostaTexto)
    local inicio, fim = string.find(respostaTexto, "```[%a%+]*[%s\n]-.-```")
    if inicio and fim then
        local bloco = string.sub(respostaTexto, inicio, fim)
        bloco = string.gsub(bloco, "```[%a%+]*", "")
        bloco = string.gsub(bloco, "```", "")
        return string.match(bloco, "^%s*(.-)%s*$")
    end
    return respostaTexto
end

local apiEndpoints = {
    "https://text.pollinations.ai/",
    "https://gen.pollinations.ai/prompt/"
}

local function consultarServidorAI(pergunta, isQA)
    if not requestFunc then
        return "-- Offline Mode\nprint('HTTP not supported')"
    end
    
    local overdriveBoost = isOverdriveActive and " [HIGH PRECISION, ZERO BUGS, ULTRA-DETAILED]" or ""
    local promptPronto
    if isQA then
        promptPronto = isPortuguese and 
            ("Responda em Português de forma super atenta e detalhada" .. overdriveBoost .. ": " .. pergunta) or 
            ("Answer in English with maximum precision and detail" .. overdriveBoost .. ": " .. pergunta)
    else
        promptPronto = "Act as an elite " .. selectedLanguage .. " engineer" .. overdriveBoost .. ". Write ONLY clean, complete, functional code in " .. selectedLanguage .. " for: " .. pergunta .. ". Wrap inside ``` blocks."
    end
        
    for _, endpoint in ipairs(apiEndpoints) do
        local url = endpoint .. HttpService:UrlEncode(promptPronto)
        local ok, res = pcall(function()
            return requestFunc({ Url = url, Method = "GET" })
        end)
        if ok and res and res.Body and not string.find(res.Body, "503") then
            return res.Body
        end
        task.wait(isOverdriveActive and 0.1 or 0.35)
    end
    return "-- Servidor ocupado / Server busy."
end

local function gerarGeometria3D(cmd)
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local basePos = root and (root.Position + root.CFrame.LookVector * 12) or Vector3.new(0, 5, 0)

    serial += 1
    local folder = Instance.new("Folder", Workspace)
    folder.Name = "AIBuild_" .. serial

    if string.find(cmd, "espada") or string.find(cmd, "sword") then
        local model = Instance.new("Model", folder)
        model.Name = "EspadaDetalhada_IA"

        local pommel = Instance.new("Part", model)
        pommel.Size = Vector3.new(0.8, 0.8, 0.8)
        pommel.Position = basePos + Vector3.new(0, 0.4, 0)
        pommel.Color = Color3.fromRGB(212, 175, 55)
        pommel.Material = Enum.Material.Metal
        pommel.Shape = Enum.PartType.Ball
        pommel.Anchored = true

        local hilt = Instance.new("Part", model)
        hilt.Size = Vector3.new(0.4, 2.6, 0.4)
        hilt.Position = basePos + Vector3.new(0, 2.1, 0)
        hilt.Color = Color3.fromRGB(70, 45, 25)
        hilt.Material = Enum.Material.Wood
        hilt.Anchored = true

        local guard = Instance.new("Part", model)
        guard.Size = Vector3.new(3.2, 0.4, 0.8)
        guard.Position = basePos + Vector3.new(0, 3.6, 0)
        guard.Color = Color3.fromRGB(212, 175, 55)
        guard.Material = Enum.Material.Metal
        guard.Anchored = true

        local blade = Instance.new("Part", model)
        blade.Size = Vector3.new(0.2, 7, 1.2)
        blade.Position = basePos + Vector3.new(0, 7.3, 0)
        blade.Color = Color3.fromRGB(225, 230, 235)
        blade.Material = Enum.Material.SmoothPlastic
        blade.Reflectance = 0.5
        blade.Anchored = true

        local tip = Instance.new("WedgePart", model)
        tip.Size = Vector3.new(0.2, 1.6, 1.2)
        tip.Position = basePos + Vector3.new(0, 11.6, 0)
        tip.Color = Color3.fromRGB(225, 230, 235)
        tip.Material = Enum.Material.SmoothPlastic
        tip.Reflectance = 0.5
        tip.Anchored = true

        if isOverdriveActive then
            local light = Instance.new("PointLight", blade)
            light.Color = RED_GLOW
            light.Range = 14
            light.Brightness = 2
            blade.Material = Enum.Material.Neon
            blade.Color = Color3.fromRGB(255, 85, 95)
        end

        return true
    end
    folder:Destroy()
    return false
end

local function processarPedido(promptText)
    if promptText == "" then return end

    abrirFullUI()
    
    local delaySpeed = isOverdriveActive and 0.15 or 0.5
    LangLabel.Text = isOverdriveActive and ("⚡ Overdrive Analyzing (" .. selectedLanguage .. ")...") or ("Analyzing (" .. selectedLanguage .. ")...")
    CodeTextBox.Text = T.analyzing .. "\n📝 [Prompt]: '" .. promptText .. "'\n💻 [Language]: " .. selectedLanguage .. " | [Overdrive]: " .. tostring(isOverdriveActive)

    task.spawn(function()
        task.wait(delaySpeed)
        local cmd = string.lower(promptText)
        local construiu = false

        if currentMode == T.modes[1] or currentMode == T.modes[2] then
            CodeTextBox.Text = CodeTextBox.Text .. "\n🔨 [3D Engine] A verificar construção geométrica..."
            construiu = gerarGeometria3D(cmd)
        end

        if construiu and currentMode ~= T.modes[3] and currentMode ~= T.modes[4] then
            LangLabel.Text = isOverdriveActive and "⚡ Workspace 3D (Overdrive Neon)" or "Workspace 3D Model"
            lastGeneratedCode = "-- Model 3D generated successfully."
            CodeTextBox.Text = CodeTextBox.Text .. "\n✅ [Success] Objeto criado no Workspace com sucesso!"
        else
            local isQA = (currentMode == T.modes[4])
            CodeTextBox.Text = CodeTextBox.Text .. "\n🌐 [HTTP Server] A gerar resposta em " .. selectedLanguage .. "..."
            local respostaBruta = consultarServidorAI(promptText, isQA)
            
            if isQA then
                LangLabel.Text = "Q&A Explanation (Answers & Doubts)"
                lastGeneratedCode = respostaBruta
                CodeTextBox.Text = respostaBruta
            else
                local codigoLimpo = extrairCodigoPuro(respostaBruta)
                LangLabel.Text = selectedLanguage .. (isOverdriveActive and " ⚡" or "")
                lastGeneratedCode = codigoLimpo
                CodeTextBox.Text = codigoLimpo
            end
        end
    end)
end

