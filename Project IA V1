local function ativarFullExperience()
    if isOverdriveActive then
        CompactBar.Visible = false
        FullWindow.Visible = true
        return
    end

    LoadingOverlay.Visible = true
    LoadingOverlay.BackgroundTransparency = 1
    LoaderBox.Size = UDim2.new(0, 410, 0, 220)

    TweenService:Create(LoadingOverlay, TweenInfo.new(0.3), {BackgroundTransparency = 0.08}):Play()
    TweenService:Create(LoaderBox, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 460, 0, 260)
    }):Play()

    local etapas = {
        {pct = 25, msg = "Loading Data", sub = "Allocating Fast HTTP Neural Sockets..."},
        {pct = 55, msg = "Loading UI Suite Plugin", sub = "Mounting Patterns, Gradients & Scaling Tools..."},
        {pct = 85, msg = "Syncing Geometry", sub = "Calibrating 3D CFrame & Multi-Language Engine..."},
        {pct = 100, msg = "OVERDRIVE READY", sub = "All AI Services & UI Suite Plugin Unlocked!"}
    }

    task.spawn(function()
        local currentPct = 0
        for _, etapa in ipairs(etapas) do
            LoadingSub.Text = etapa.msg
            while currentPct < etapa.pct do
                currentPct += 2
                if currentPct > etapa.pct then currentPct = etapa.pct end
                PercentLabel.Text = currentPct .. "%"
                AssetsCountLabel.Text = currentPct .. "/100 ASSETS"
                BarFill.Size = UDim2.new(currentPct / 100, 0, 1, 0)
                task.wait(0.02)
            end
            task.wait(0.2)
        end

        task.wait(0.3)
        isOverdriveActive = true

        FullExpBtn.Text = "🔥 Overdrive 100%"
        FullExpBtn.TextColor3 = GREEN_ONLINE
        feStroke.Color = GREEN_ONLINE

        BrandLogo.Text = '<b>✳ Capacity Studio</b>  <font color="#2ed573" size="10">⚡ OVERDRIVE 100%</font>'
        ModelBadge.Text = '<font color="#eb3741">⚡</font> Claude 4 Overdrive'

        for _, grad in ipairs(animatedGradients) do
            grad.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, RED_GLOW),
                ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 195, 75)),
                ColorSequenceKeypoint.new(1, RED_GLOW)
            })
        end

        TweenService:Create(LoadingOverlay, TweenInfo.new(0.35), {BackgroundTransparency = 1}):Play()
        task.wait(0.35)
        LoadingOverlay.Visible = false

        -- Abre a Full UI automaticamente ao concluir os 100%
        CompactBar.Visible = false
        FullWindow.Visible = true
    end)
end

